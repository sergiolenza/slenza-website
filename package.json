{
  "name": "slenza-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "lingui compile --typescript && next dev",
    "build": "pnpm check:boundaries && lingui extract && lingui compile --typescript && next build",
    "compile": "lingui compile --typescript",
    "start": "next start",
    "extract": "lingui extract",
    "extract:clean": "lingui extract --clean",
    "lint": "biome lint && pnpm check:boundaries",
    "lint:fix": "biome check --write --unsafe",
    "format": "biome format --write .",
    "check": "biome check --write . && pnpm check:boundaries",
    "check:boundaries": "node scripts/check-architecture-boundaries.mjs",
    "bump:patch": "pnpm version patch --no-git-tag-version",
    "bump:minor": "pnpm version minor --no-git-tag-version",
    "bump:major": "pnpm version major --no-git-tag-version",
    "test": "vitest run --coverage",
    "test:watch": "vitest --coverage",
    "test:coverage": "pnpm test",
    "lint:staged": "biome check --staged --no-errors-on-unmatched",
    "prepare": "husky"
  },
  "dependencies": {
    "@lingui/core": "^6.9.0",
    "@lingui/react": "^6.9.0",
    "lucide-react": "^1.16.0",
    "next": "16.4.0",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@lingui/cli": "^6.9.0",
    "@lingui/swc-plugin": "^6.7.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "typescript": "5.7.3",
    "vitest": "^5.0.3"
  }
}
